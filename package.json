{
  "name": "tiendasaas",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-tenant online store service for local businesses (Vendure + Mercado Pago).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "codegen": "npm run codegen --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.71.2"
  }
}
