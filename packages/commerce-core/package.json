{
  "name": "@tiendasaas/commerce-core",
  "version": "0.1.0",
  "private": true,
  "description": "Commerce logic for storefronts: catalogue, cart, checkout, Mercado Pago payment flow and optional account. No UI, no secrets, no Mercado Pago SDK.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema.shop.graphql"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "codegen": "graphql-codegen --config codegen.ts",
    "schema:update": "graphql-codegen --config codegen.schema.ts"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@graphql-codegen/schema-ast": "^6.1.1",
    "@swc/core": "^1.16.18",
    "@vendure/core": "3.8.0",
    "@vendure/testing": "3.8.0",
    "msw": "^3.0.3",
    "tsup": "^9.0.0",
    "unplugin-swc": "^2.0.0",
    "vendure-plugin-mercadopago": "*",
    "vitest": "^5.0.5"
  }
}
