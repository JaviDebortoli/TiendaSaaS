# Copy to `.env` and fill in. Never commit real values.
# In production these are injected by the deployment platform (PRD 16.8).

# --- General -----------------------------------------------------------------
# dev | prod. Controls dev-only conveniences (dev mailbox, GraphQL playground, harden apiMode).
APP_ENV=dev
# Public base URL of the Vendure server (HTTPS in production). Used for OAuth/webhook URLs.
PUBLIC_URL=http://localhost:3000
# Port the Vendure server listens on.
PORT=3000
# Secret used to sign session cookies. Use a long random value.
COOKIE_SECRET=change-me
# Comma-separated list of allowed CORS origins. Must be explicit in production.
CORS_ORIGINS=http://localhost:3000
# Set when running behind a reverse proxy (number of hops, or "true").
TRUST_PROXY=

# --- Database (PostgreSQL 17) --------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tiendasaas
DB_USERNAME=tiendasaas
DB_PASSWORD=change-me
# Set to "true" only for local development/tests. Production uses migrations.
DB_SYNCHRONIZE=false

# --- Superadmin ----------------------------------------------------------------
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-me

# --- Mercado Pago (Argentina) --------------------------------------------------
# Application credentials (one application for the whole platform, PRD 9.1).
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Secret key generated in "Tus integraciones" > Webhooks. Used to validate x-signature.
MP_WEBHOOK_SECRET=
# Static OAuth redirect URI registered in the Mercado Pago application (must match exactly).
MP_REDIRECT_URI=https://example.invalid/mercadopago/oauth/callback
# 32 bytes, base64 encoded (generate with: openssl rand -base64 32). AES-256-GCM key.
MP_TOKEN_ENCRYPTION_KEY=
# Where notifications are expected (PRD V1/V2 plan B):
#   application  = app-level webhook configured in "Tus integraciones" (default, design of PRD 9.7)
#   preference   = notification_url set per preference, with the channel in the path
MP_WEBHOOK_MODE=application
# Use the sandbox flag (test_token) when exchanging OAuth codes (PRD 9.2).
MP_OAUTH_TEST_TOKEN=false
# Webhook timestamp tolerance, in seconds.
MP_WEBHOOK_TOLERANCE_SECONDS=600
# Preference validity, in minutes (PRD 9.6).
MP_PREFERENCE_TTL_MINUTES=30
# Where the dashboard sends the owner after OAuth finishes.
MP_DASHBOARD_URL=http://localhost:3000/dashboard
# Mercado Pago: when an account that a store stopped using is released (optional).
# A retired link is released once BOTH periods have passed: days since its last settled payment,
# and days since it was retired. The account's tokens are deleted when no store uses it any more.
MP_RELEASE_AFTER_LAST_PAYMENT_DAYS=180
MP_RELEASE_AFTER_RETIRED_DAYS=30

# --- S3 compatible storage (assets) --------------------------------------------
# Local development uses MinIO from docker-compose.yml.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=tiendasaas-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me
S3_REGION=us-east-1
# MinIO and some providers need path-style addressing.
S3_FORCE_PATH_STYLE=true
# Public base URL used to build asset URLs (reverse proxy / CDN in front of the server).
ASSET_URL_PREFIX=

# --- Email (SMTP) --------------------------------------------------------------
# In dev (APP_ENV=dev) emails are written to disk and shown at /mailbox instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Platform <no-reply@example.invalid>"

# --- Reference storefront (apps/storefront-reference) --------------------------
# Server-side only; never exposed to the browser.
VENDURE_SHOP_API_URL=http://localhost:3000/shop-api
# Channel token of the store this frontend serves (never the default channel).
VENDURE_CHANNEL_TOKEN=
# Public URL of this storefront (used for Mercado Pago back_urls; must not be localhost).
STOREFRONT_PUBLIC_URL=https://example.invalid
