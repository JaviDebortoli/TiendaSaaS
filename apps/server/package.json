{
  "name": "@tiendasaas/server",
  "private": true,
  "version": "0.1.0",
  "description": "Vendure server and worker (same code, two processes).",
  "scripts": {
    "dev": "vendure dev all",
    "dev:server": "vendure dev server",
    "dev:worker": "vendure dev worker",
    "build": "tsc -p tsconfig.json",
    "build:dashboard": "vendure build dashboard",
    "start:server": "node ./dist/index.js",
    "start:worker": "node ./dist/index-worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "migration:generate": "ts-node src/migration-generate.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/lib-storage": "^3.1152.0",
    "@vendure/asset-server-plugin": "3.8.0",
    "@vendure/core": "3.8.0",
    "@vendure/dashboard": "3.8.0",
    "@vendure/email-plugin": "3.8.0",
    "@vendure/graphiql-plugin": "3.8.0",
    "@vendure/harden-plugin": "3.8.0",
    "dotenv": "^17.0.0",
    "pg": "^8.23.1",
    "typeorm": "^0.3.21"
  },
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@vendure/cli": "3.8.0",
    "@vendure/testing": "3.8.0",
    "ts-node": "^10.9.2",
    "unplugin-swc": "^2.0.0",
    "vite": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
