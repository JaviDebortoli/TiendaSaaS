<mjml>
  <mj-head>
    <mj-title>{{ title }}</mj-title>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="22px" color="#222222" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#ffffff">
    <mj-section padding="24px 16px">
      <mj-column>
        <mj-text font-size="12px" color="#666666">{{ storeName }}</mj-text>
        <mj-text font-size="20px" font-weight="bold">{{ title }}</mj-text>
        <mj-text>{{ message }}</mj-text>
        {{#if orderCode}}
        <mj-text>Pedido: <strong>{{ orderCode }}</strong></mj-text>
        {{/if}}
        {{#if mpPaymentId}}
        <mj-text>Pago de Mercado Pago: <strong>{{ mpPaymentId }}</strong></mj-text>
        {{/if}}
        {{#if detail}}
        <mj-text color="#666666">Detalle: {{ detail }}</mj-text>
        {{/if}}
        <mj-text>{{ action }}</mj-text>
        <mj-button background-color="#171717" href="{{ adminDashboardUrl }}">Abrir el panel</mj-button>
        <mj-text font-size="12px" color="#666666">Este aviso lo envía {{ platformName }}.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
